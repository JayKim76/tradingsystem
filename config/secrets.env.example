# ==============================================================
# 세인투 투자 비서 — 환경 변수 예시
# 이 파일을 복사해서 config/.env 로 저장한 뒤 실제 값을 입력하세요.
# .env 파일은 절대 Git에 커밋하지 마세요.
# ==============================================================

# --------------------------------------------------------------
# Google OAuth 2.0 Credentials
# 발급 방법: docs/google_sheets_manual_setup.md 참조
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Google Sheets 스프레드시트 ID
# URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# --------------------------------------------------------------
# Telegram Bot
# 발급 방법: docs/telegram_manual_setup.md 참조
# --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --------------------------------------------------------------
# 공통 설정
# --------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Seoul

# 리포트 출력 경로 (기본값 사용 시 아래 주석 유지)
# DAILY_REPORT_DIR=reports/daily
# WEEKLY_REPORT_DIR=reports/weekly
# LOG_DIR=logs
